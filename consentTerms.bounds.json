  "dailyLoss": {
    "formula": "limitLovelace = floor(dayOpenValueLovelace * dailyLossBps / 10000)",
    "anchor": "dayOpenValueLovelace is the book's first complete valuation of the UTC day; an incomplete valuation never writes the anchor and never trips the limit; a missing or unreadable anchor fails closed for that book only (spec 11.2 and its addendum).",
