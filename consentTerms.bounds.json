{
  "note": "Parity fixture for the consent terms bounds (D2 spec 4.1 as superseded by section 11, and spec 5). Authored in adam-oc; SaturnSwapWeb copies it byte for byte. The keeper and the page accept or refuse a signed value against these; they never clamp one (spec 4.3). Bounds may only widen after the first client signs (spec 0.5).",
  "provenance": {
    "repo": "Flux-Point-Studios/adam-oc",
    "path": "docs/specs/D2-consent-v2.md",
    "commit": "afe161186870939103be2c8ebb73cbfd89cacc14",
    "sections": [
      "4.1",
      "5",
      "11.2"
    ]
  },
  "conventions": {
    "units": "Knob values are integers in the unit given. Lovelace values are integers (all below 2^53).",
    "cases": "Each terms case lists every rule it breaks in `violations`, by rule id; an empty list is accepted."
  },
  "knobOrder": [
    "spreadBps",
    "maxDepthAda",
    "dailyLossBps",
    "minRepriceBps"
  ],
  "knobs": {
    "spreadBps": {
      "unit": "bps, the full spread between the book's buying and selling prices",
      "default": 800,
      "min": 400,
      "max": 6000
    },
    "maxDepthAda": {
      "unit": "whole ADA, book value cap (both legs, the token at our price)",
      "default": 120,
      "min": 60,
      "max": 120
    },
    "dailyLossBps": {
      "unit": "bps of the book's value at its first complete valuation of the UTC day",
      "default": 500,
      "min": 100,
      "max": 5000
    },
    "minRepriceBps": {
      "unit": "bps move of our feed mid before a reprice",
      "default": 150,
      "min": 150,
      "max": 1000
    }
  },
  "removedKnobs": {
    "dailyLossKillAda": "replaced by dailyLossBps (spec 11.2); a statement, pairs entry or verdict carrying it is not v2 terms"
  },
  "crossConstraint": {
    "id": "reprice-within-half-spread",
    "rule": "2 * minRepriceBps < spreadBps",
    "strict": true
  },
  "tokenDecimals": {
    "min": 0,
    "max": 18
  },
  "rules": {
    "spreadBps-min": "spreadBps >= 400",
    "spreadBps-max": "spreadBps <= 6000",
    "maxDepthAda-min": "maxDepthAda >= 60",
    "maxDepthAda-max": "maxDepthAda <= 120",
    "dailyLossBps-min": "dailyLossBps >= 100",
    "dailyLossBps-max": "dailyLossBps <= 5000",
    "minRepriceBps-min": "minRepriceBps >= 150",
    "minRepriceBps-max": "minRepriceBps <= 1000",
    "reprice-within-half-spread": "2 * minRepriceBps < spreadBps",
    "decimals-min": "tokenDecimals >= 0",
    "decimals-max": "tokenDecimals <= 18"
  },
  "termsCases": [
